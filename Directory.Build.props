<Project>
  <!-- Product versioning is independent from WebView2 cache invalidation. The latter is computed from the
       files under viewer/ at runtime. Keep only one release version here. -->
  <PropertyGroup>
    <TrailViewerVersionPrefix>1.17.2</TrailViewerVersionPrefix>
    <TrailViewerVersionSuffix></TrailViewerVersionSuffix>
    <TrailViewerViewerProtocolVersion>1</TrailViewerViewerProtocolVersion>
    <TrailViewerPreferencesSchemaVersion>1</TrailViewerPreferencesSchemaVersion>
  </PropertyGroup>
</Project>
